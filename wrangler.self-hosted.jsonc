{
  // Thrive on your own Cloudflare account (no ChatGPT Sites).
  // Nonsecret settings only. Secrets: `npx wrangler secret put NAME --config wrangler.self-hosted.jsonc`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thrive",
  "main": "build/self-hosted-worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "triggers": { "crons": ["0 * * * *"] },
  "observability": { "enabled": true },
  "ratelimits": [
    { "name": "RATE_LIMIT_SIGNUP", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } },
    { "name": "RATE_LIMIT_PUBLIC", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
  ],
  "vars": {
    "THRIVE_AUTH_MODE": "supabase",
    "THRIVE_DATA_BACKEND": "supabase",
    // Final HTTPS origin, no path. Update after the first deploy or when a custom domain is attached.
    "THRIVE_APP_URL": "https://thrive.lucas-didier-3b9.workers.dev",
    "SUPABASE_URL": "https://zhhysylxzgyjpwfkymjj.supabase.co",
    // Only this confirmed Google account can sign in.
    "THRIVE_OWNER_EMAIL": "owner@example.com",
    // Thrive's own emails (summaries and notices) send from runonthrive.com once RESEND_API_KEY is set here.
    "THRIVE_NOTIFICATIONS_FROM": "Thrive <notifications@runonthrive.com>",
    // Thrive Cloud billing (docs/launch.md › 10): a 7-day trial without a card, then a Paddle subscription.
    // "off" until Paddle is set up, then "paddle". The client-side token (test_… sandbox, live_… live) and
    // the price id are public. The Paddle API key and webhook signing key are Worker secrets.
    "THRIVE_BILLING": "off",
    "PADDLE_CLIENT_TOKEN": "",
    "PADDLE_PRICE_ID": "",
    "THRIVE_GOOGLE_LOGIN": "true",
    "THRIVE_MICROSOFT_LOGIN": "false",
    "THRIVE_COMMUNICATIONS_PROVIDER": "nylas",
    "NYLAS_REGION": "eu",
    "NYLAS_ENVIRONMENT": "sandbox",
    "NYLAS_REDIRECT_URI": "https://thrive.lucas-didier-3b9.workers.dev/api/nylas/callback"
  }
}
