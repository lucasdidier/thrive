{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(node --test *)",
      "Bash(npm run build)",
      "Bash(npm run dev *)",
      "Bash(npm run preview:design)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(*wrangler* deploy*)",
      "Bash(*--remote*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.dev.vars)",
      "Read(./.wrangler/state/**)"
    ]
  }
}
