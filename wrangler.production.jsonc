{
  // Thrive production: real beta users, separate Supabase project, custom domain.
  // Staging (your own workspace on the "Thrive staging" project) stays in wrangler.self-hosted.jsonc.
  // Secrets: `npx wrangler secret put NAME --config wrangler.production.jsonc`.
  // `npm run deploy:production` refuses to run while any REPLACE_ value remains.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thrive-production",
  "main": "build/self-hosted-worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  // runonthrive.com is the marketing site, app.runonthrive.com the app (server/hosts.mjs).
  "routes": [{ "pattern": "runonthrive.com", "custom_domain": true }, { "pattern": "app.runonthrive.com", "custom_domain": true }],
  // Hourly: summaries at 8:00 local time, invite emails, nightly backup at 03:00 UTC.
  "triggers": { "crons": ["0 * * * *"] },
  "observability": { "enabled": true },
  // Abuse limits per client IP: access requests and emailed sign-in codes 3/min each; sign-in, client responses and form posts 30/min.
  "ratelimits": [
    { "name": "RATE_LIMIT_SIGNUP", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } },
    { "name": "RATE_LIMIT_PUBLIC", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
    // AI connectors call /mcp in bursts; signed-in writes are counted per account (server/runtime.mjs).
    { "name": "RATE_LIMIT_MCP", "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } },
    { "name": "RATE_LIMIT_WRITE", "namespace_id": "1004", "simple": { "limit": 120, "period": 60 } }
  ],
  "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "thrive-backups" }],
  "vars": {
    "THRIVE_AUTH_MODE": "supabase",
    "THRIVE_DATA_BACKEND": "supabase",
    "THRIVE_APP_URL": "https://app.runonthrive.com",
    "THRIVE_SITE_URL": "https://runonthrive.com",
    "SUPABASE_URL": "https://vacyeyashxsekeitkrcg.supabase.co",
    // Open sign-up: anyone can create an account with Google or an emailed code, free for now.
    // "invite" restricts sign-in to emails in thrive_beta_invites.
    "THRIVE_ACCESS": "open",
    // Receives access requests and error alerts.
    "THRIVE_ADMIN_EMAIL": "owner@example.com",
    "THRIVE_SUPPORT_EMAIL": "hello@runonthrive.com",
    // Gets a "New sign-up" email the first time each new account opens its workspace (server/signup-alert.mjs).
    "THRIVE_SIGNUP_ALERTS": "hello@runonthrive.com",
    "THRIVE_NOTIFICATIONS_FROM": "Thrive <notifications@runonthrive.com>",
    // Thrive Cloud billing (docs/launch.md › 10): a 7-day trial without a card, then a Paddle subscription.
    // "off" until Paddle is set up, then "paddle". The client-side token (test_… sandbox, live_… live) and
    // the price id are public. The Paddle API key and webhook signing key are Worker secrets.
    // Basic product analytics (server/analytics.mjs): page and button names in thrive_usage.
    "THRIVE_ANALYTICS": "on",
    // Daily digest at 7:00 Lisbon (server/digest.mjs): visits, sign-ups, plans, usage and Search Console.
    // Search Console needs the GSC_SERVICE_ACCOUNT secret (a service account JSON key).
    "THRIVE_DIGEST_TO": "owner@example.com",
    "GSC_SITE": "sc-domain:runonthrive.com",
    "THRIVE_BILLING": "paddle",
    "PADDLE_CLIENT_TOKEN": "live_1c255d0743c442de3269d7ce3f9",
    "PADDLE_PRICE_ID": "pri_01m7386yc3jfzqrateakq0pmq8",
    "PADDLE_YEARLY_PRICE_ID": "pri_01m73885x8azk4aj341d632e36",
    "THRIVE_GOOGLE_LOGIN": "true",
    // Google returns to runonthrive.com/auth/google/callback once this client's secret is stored on the
    // Worker (docs/launch.md, step 3.7); until then sign-in uses Supabase's hosted redirect.
    "GOOGLE_CLIENT_ID": "930813839213-au7rujg4dcaiid82rlbaaq0it8cc4550.apps.googleusercontent.com",
    "THRIVE_MICROSOFT_LOGIN": "false",
    "THRIVE_COMMUNICATIONS_PROVIDER": "nylas",
    "NYLAS_REGION": "eu",
    "NYLAS_ENVIRONMENT": "sandbox",
    "NYLAS_REDIRECT_URI": "https://app.runonthrive.com/api/nylas/callback"
  }
}
